{% from "icons.njk" import icon %}
{% set activeLocale = locale or "en" %}
{% set t = i18n[activeLocale] or i18n.en %}
{% set activeNavigation = activeLocale | localizedNavigation %}
<aside class="docs-sidebar" id="docs-navigation" data-docs-sidebar>
  <nav aria-label="{{ t.docsNav }}">
    {% for group in activeNavigation %}
      <section class="docs-nav__group">
        <h2>{{ group.label }}</h2>
        <ul>
          {% for item in group.items %}
            <li>
              <a class="docs-nav__link{% if page.url == item.url %} is-active{% endif %}" href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>
                <span class="docs-nav__icon">{{ icon(item.icon) }}</span>
                <span>{{ item.title }}</span>
              </a>
            </li>
          {% endfor %}
        </ul>
      </section>
    {% endfor %}
  </nav>
</aside>
