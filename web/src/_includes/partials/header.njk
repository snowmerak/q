  <div class="site-header__inner">
    <a class="site-brand" href="/" aria-label="q home">q</a>
    <nav class="top-nav" aria-label="Primary navigation" data-top-nav>
      <a href="/guide/introduction/"{% if page.url | startsWith('/guide/') or page.url | startsWith('/workflows/') %} aria-current="page"{% endif %}>Guide</a>
      <a href="/concepts/runtime/"{% if page.url | startsWith('/concepts/') %} aria-current="page"{% endif %}>Concepts</a>
      <a href="/reference/commands/"{% if page.url | startsWith('/reference/') %} aria-current="page"{% endif %}>Reference</a>
      <a href="{{ site.repository }}">GitHub<span class="sr-only"> (opens repository)</span></a>
    </nav>
    <a class="header-github mp-button mp-button--secondary mp-button--sm" href="{{ site.repository }}" aria-label="View q on GitHub">
