<header class="site-header">
  {% set activeLocale = locale or "en" %}
  {% set t = i18n[activeLocale] or i18n.en %}
  {% set contentPath = page.url | stripLocale %}
  <a class="skip-link" href="#main-content">{{ t.skip }}</a>
  <div class="site-header__inner">
    <a class="site-brand" href="{{ '/' | localeUrl(activeLocale) }}" aria-label="{{ t.home }}">q</a>
    <nav class="top-nav" aria-label="{{ t.primaryNav }}" data-top-nav>
      <a href="{{ '/guide/introduction/' | localeUrl(activeLocale) }}"{% if contentPath | startsWith('/guide/') or contentPath | startsWith('/workflows/') %} aria-current="page"{% endif %}>{{ t.guide }}</a>
      <a href="{{ '/concepts/runtime/' | localeUrl(activeLocale) }}"{% if contentPath | startsWith('/concepts/') %} aria-current="page"{% endif %}>{{ t.concepts }}</a>
      <a href="{{ '/reference/commands/' | localeUrl(activeLocale) }}"{% if contentPath | startsWith('/reference/') %} aria-current="page"{% endif %}>{{ t.reference }}</a>
      <a href="{{ site.repository }}">GitHub<span class="sr-only">{{ t.repositorySuffix }}</span></a>
    </nav>
    <div class="header-actions">
      <details class="language-switcher">
        <summary aria-label="{{ t.language }}">{{ activeLocale | localeShort }}</summary>
        <div class="language-switcher__menu">
          {% for language in locales %}<a href="{{ page.url | localeUrl(language.id) }}" lang="{{ language.htmlLang }}" hreflang="{{ language.htmlLang }}"{% if language.id == activeLocale %} aria-current="page"{% endif %}>{{ language.label }}</a>{% endfor %}
        </div>
      </details>
      <a class="header-github mp-button mp-button--secondary mp-button--sm" href="{{ site.repository }}" aria-label="{{ t.repository }}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.8a9.2 9.2 0 0 0-2.9 17.9c.5.1.6-.2.6-.5v-2c-2.8.6-3.4-1.2-3.4-1.2-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.6 1 1.6 1 .9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.7-1.4-2.2-.3-4.6-1.1-4.6-5a3.9 3.9 0 0 1 1-2.7c-.1-.3-.4-1.3.1-2.7 0 0 .9-.3 2.8 1A9.7 9.7 0 0 1 12 5.6a9.7 9.7 0 0 1 2.5.4c2-1.3 2.8-1 2.8-1 .6 1.4.2 2.4.1 2.7a3.9 3.9 0 0 1 1 2.7c0 3.9-2.4 4.7-4.6 5 .4.3.7.9.7 1.8v3c0 .4.1.6.7.5A9.2 9.2 0 0 0 12 2.8Z"></path></svg>GitHub
      </a>
    </div>
    <button class="nav-toggle" type="button" aria-label="{{ t.toggleNav }}" aria-expanded="false" data-nav-toggle>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
    </button>
  </div>
</header>
