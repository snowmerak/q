{% set activeLocale = locale or "en" %}
{% set copy = home[activeLocale] %}
<section class="hero">
  <div class="hero__copy">
    <h1>{{ copy.heading }}</h1>
    <p>{{ copy.lead }}</p>
    <div class="hero__actions">
      <a class="mp-button mp-button--primary" href="{{ '/guide/introduction/' | localeUrl(activeLocale) }}">{{ copy.start }}</a>
      <a class="mp-button mp-button--secondary" href="{{ site.repository }}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.8a9.2 9.2 0 0 0-2.9 17.9c.5.1.6-.2.6-.5v-2c-2.8.6-3.4-1.2-3.4-1.2-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.6 1 1.6 1 .9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.7-1.4-2.2-.3-4.6-1.1-4.6-5a3.9 3.9 0 0 1 1-2.7c-.1-.3-.4-1.3.1-2.7 0 0 .9-.3 2.8 1A9.7 9.7 0 0 1 12 5.6a9.7 9.7 0 0 1 2.5.4c2-1.3 2.8-1 2.8-1 .6 1.4.2 2.4.1 2.7a3.9 3.9 0 0 1 1 2.7c0 3.9-2.4 4.7-4.6 5 .4.3.7.9.7 1.8v3c0 .4.1.6.7.5A9.2 9.2 0 0 0 12 2.8Z" fill="currentColor" stroke="none"></path></svg>
        {{ copy.github }}
      </a>
    </div>
  </div>
  <div class="terminal" aria-label="{{ copy.terminalLabel }}">
    <div class="terminal__bar">
      <span class="terminal__lights" aria-hidden="true"><i></i><i></i><i></i></span><span>~/project</span>
      <button class="terminal__copy" type="button" data-copy-value="q sprint implement the requested feature"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="11" height="11" rx="2"></rect><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path></svg><span>{{ copy.copy }}</span></button>
    </div>
    <div class="terminal__body">
      <div class="terminal__command"><span>$</span> q sprint implement the requested feature</div>
      <div class="trace-list">
        {% for trace in copy.traces %}<div class="trace-row {{ trace.state }}"><i class="trace-row__dot"></i><div class="trace-row__body"><strong>{{ trace.agent }}</strong><span>{{ trace.detail }}</span></div><span class="trace-row__status">{{ trace.status }}</span></div>{% endfor %}
      </div>
    </div>
  </div>
</section>

<section class="feature-band"><div class="feature-band__inner">
  <h2>{{ copy.featureHeading }}</h2><p class="feature-band__lead">{{ copy.featureLead }}</p>
  <div class="feature-columns">
    {% for feature in copy.features %}<article class="feature-item"><span class="feature-item__icon">
      {% if feature.icon == 'plan' %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h9l4 4v14H6zM15 3v5h5M9 12h7M9 16h5"></path></svg>{% endif %}
      {% if feature.icon == 'delegate' %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 7 5 5-5 5m8 0h6"></path></svg>{% endif %}
      {% if feature.icon == 'remember' %}<svg viewBox="0 0 24 24" aria-hidden="true"><ellipse cx="12" cy="6" rx="7" ry="3"></ellipse><path d="M5 6v6c0 1.7 3.1 3 7 3s7-1.3 7-3V6M5 12v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6"></path></svg>{% endif %}
    </span><h3>{{ feature.title }}</h3><p>{{ feature.body }}</p></article>{% endfor %}
  </div>
</div></section>

<section class="workflow-section">
  <h2>{{ copy.workflowHeading }}</h2><p>{{ copy.workflowLead }}</p>
  <div class="workflow-rail" aria-label="{{ i18n[activeLocale].workflow }}">{% for step in copy.steps %}<div><span>0{{ loop.index }}</span><strong>{{ step }}</strong></div>{% endfor %}</div>
  <div class="home-cta"><div><h3>{{ copy.ctaHeading }}</h3><p>{{ copy.ctaBody }}</p></div><a class="mp-button mp-button--primary" href="{{ '/guide/install/' | localeUrl(activeLocale) }}">{{ copy.cta }}</a></div>
</section>
