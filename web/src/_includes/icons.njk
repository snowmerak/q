{% macro icon(name) %}
  {% if name == "document" %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h7l4 4v14H7z"></path><path d="M14 3v5h5M10 12h5M10 16h5"></path></svg>
  {% elif name == "download" %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 19h14"></path></svg>
  {% elif name == "terminal" %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 7 4 4-4 4m7 1h6"></path></svg>
  {% elif name == "nodes" %}<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="6" r="2"></circle><circle cx="18" cy="6" r="2"></circle><circle cx="12" cy="18" r="2"></circle><path d="m8 7 3 9m5-9-3 9M8 6h8"></path></svg>
  {% elif name == "play" %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 11 7-11 7z"></path></svg>
  {% elif name == "agents" %}<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3"></circle><circle cx="17" cy="10" r="2"></circle><path d="M3.5 19c.5-3.5 2.5-5 5.5-5s5 1.5 5.5 5M14 15c3.5-.5 5.5.8 6 3.5"></path></svg>
  {% elif name == "grid" %}<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="6" height="6" rx="1"></rect><rect x="14" y="4" width="6" height="6" rx="1"></rect><rect x="4" y="14" width="6" height="6" rx="1"></rect><rect x="14" y="14" width="6" height="6" rx="1"></rect></svg>
  {% elif name == "cloud" %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 18h11a4 4 0 0 0 .5-8 6.5 6.5 0 0 0-12.4 1.5A3.3 3.3 0 0 0 7 18Z"></path></svg>
  {% elif name == "graph" %}<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="2"></circle><circle cx="18" cy="5" r="2"></circle><circle cx="18" cy="19" r="2"></circle><path d="m7 11 9-5M7 13l9 5"></path></svg>
  {% elif name == "archive" %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16v13H4zM3 4h18v4H3zM9 12h6"></path></svg>
  {% elif name == "gate" %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 21V7a6 6 0 0 1 12 0v14M6 12h12M12 12v9"></path></svg>
  {% elif name == "command" %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 7 4 5-4 5m7 0h7"></path></svg>
  {% elif name == "settings" %}<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><path d="M19 12a7 7 0 0 0-.1-1l2-1.5-2-3.4-2.4 1A8 8 0 0 0 15 6l-.3-2.6h-4L10.5 6A8 8 0 0 0 9 7.1l-2.4-1-2 3.4L6.7 11a7 7 0 0 0 0 2l-2 1.5 2 3.4 2.4-1A8 8 0 0 0 10.5 18l.3 2.6h4L15 18a8 8 0 0 0 1.5-1.1l2.4 1 2-3.4L18.9 13a7 7 0 0 0 .1-1Z"></path></svg>
  {% endif %}
{% endmacro %}
